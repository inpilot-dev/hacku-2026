# Server environment. Never put keys in VITE_ variables or commit .env.
# Existing model provider (optional; absent keys are reported, not fabricated).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# General web search: duckduckgo or serper. No automatic silent failover.
MANDATE_SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=
# Durable recovery uses the local sandbox: no Stripe/payment keys.
# API and recovery worker MUST share data, keys and catalog.
# Set absolute paths in the server environment before starting both processes.
# MANDATE_WALLET_DATA_DIR=/absolute/path/to/persistent-wallet
# MANDATE_WALLET_KEY_DIR=/absolute/path/to/persistent-wallet/keys
# MANDATE_CATALOG_PATH=/absolute/path/to/data/catalog/stores.json
# To retain demo records across restarts:
# MANDATE_DEMO_DATA_DIR=/absolute/path/to/persistent-wallet
